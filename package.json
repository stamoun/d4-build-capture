{
  "name": "diablo-build-capture",
  "productName": "Diablo Build Capture",
  "version": "0.1.0",
  "description": "Capture Diablo IV item tooltips and export build snapshots to Obsidian.",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/business.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/plugin-fuses": "^7.8.1",
    "@electron-forge/plugin-webpack": "^7.8.1",
    "@electron-forge/shared-types": "^7.8.1",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^22.15.0",
    "@types/screenshot-desktop": "^1.15.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "css-loader": "^7.1.2",
    "electron": "^37.0.0",
    "eslint": "^9.25.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "node-loader": "^2.1.0"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "screenshot-desktop": "^1.15.4",
    "sharp": "^0.34.2",
    "zod": "^3.24.3"
  }
}
